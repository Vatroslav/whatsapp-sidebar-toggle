{
  "manifest_version": 3,
  "name": "WhatsApp Web + Gmail Sidebar Toggle",
  "description": "Hide/show the WhatsApp Web sidebar and the Gmail main menu.",
  "version": "1.2.0",
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Toggle sidebar (WhatsApp Web / Gmail)"
  },
  "permissions": ["activeTab", "scripting"],
  "commands": {
    "toggle": {
      "suggested_key": {
        "default": "Ctrl+Shift+S",
        "mac": "Command+Shift+S"
      },
      "description": "Toggle sidebar (WhatsApp Web chat list / Gmail main menu)"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
